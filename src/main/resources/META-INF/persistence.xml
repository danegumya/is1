<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="movies" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>java:/MoviesDS</jta-data-source>
        <properties>
            <property name="hibernate.default_schema" value="s468127" />
            <property name="hibernate.hbm2ddl.auto" value="validate" />
            <property name="hibernate.jdbc.time_zone" value="UTC" />
            <property name="jakarta.persistence.validation.mode" value="CALLBACK" />
        </properties>
    </persistence-unit>
</persistence>
